{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "cashclaw-trading-bot",
	"compatibility_date": "2026-08-12",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "cashclaw-trading-bot"
		}
	],
	// D1 database — cashclaw-db (provisioned 2026-08-13)
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "cashclaw-db",
			"database_id": "c054f5a3-e7b9-42f0-88eb-dfffc4f8feae"
		}
	],
	"r2_buckets": [
		{
			"binding": "NEXT_INC_CACHE_R2_BUCKET",
			"bucket_name": "cashclaw-opennext-cache"
		}
	],
	"images": {
		"binding": "IMAGES"
	},
	// CORS — comma-separated allowed origins (set in production via Cloudflare dashboard)
	"vars": {
		"ALLOWED_ORIGINS": "https://cashclaw.pages.dev,http://localhost:3000"
	},

	// CF Cron — drain exchange request queues every 5 minutes
	"triggers": {
		"crons": ["*/5 * * * *"]
	}
}
