{
  "name": "cashclaw-trading-bot",
  "main": "src/worker.ts",
  "account_id": "YOUR_ACCOUNT_ID",
  "compatibility_date": "2026-07-14",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cashclaw-db",
      "database_id": "YOUR_DB_ID"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "YOUR_KV_ID"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "routes": []
}
