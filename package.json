{
  "name": "trade-bot",
  "version": "1.0.0",
  "description": "CashClaw AI Trading Bot Platform",
  "private": true,
  "scripts": {
    "build": "next build",
    "build:worker": "npx @opennextjs/cloudflare build",
    "dev": "next dev",
    "start": "next start",
    "lint": "eslint src/ --max-warnings 78",
    "type-check": "tsc --noEmit",
    "db:generate": "wrangler d1 migrations create cashclaw-db --local",
    "db:apply": "wrangler d1 migrations apply cashclaw-db --local",
    "db:apply:remote": "wrangler d1 migrations apply cashclaw-db",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "ccxt": "^4.5.73",
    "hono": "^4.12.30",
    "lightweight-charts": "^4.2.0",
    "lucide-react": "^0.469.0",
    "next": "^16.2.10",
    "next-intl": "^4.13.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^8.57.0",
    "eslint-config-next": "^16.2.10",
    "eslint-plugin-react": "^7.37.5",
    "typescript": "^5.7.0",
    "vite-tsconfig-paths": "^4.3.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.122.0"
  }
}
