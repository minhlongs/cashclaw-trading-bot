# CashClaw Trade Bot — Environment Variables
# Copy to .env for local development. Never commit .env (contains secrets).

# --- Build-time (injected by `npm run deploy`, set locally for dev builds) ---
GIT_COMMIT_SHA=0000000000000000000000000000000000000000
BUILD_TIMESTAMP=2026-08-19T00:00:00.000Z

# --- Cloudflare Workers secrets (set via `wrangler secret put <KEY>`) ---
# ADMIN_TOKEN — bearer token guarding /internal/api/bots/*, /api/killswitch/*, /api/cron/*
ADMIN_TOKEN=change-me
# ENCRYPTION_KEY — AES key for exchange credential encryption at rest (32 bytes, base64)
ENCRYPTION_KEY=change-me

# --- Cloudflare Workers vars (set in wrangler.jsonc or dashboard) ---
# ALLOWED_ORIGINS — comma-separated CORS allowlist
ALLOWED_ORIGINS=https://cashclaw.pages.dev,http://localhost:3000
# VERSION — fallback shown by the worker version endpoint when not set by binding
VERSION=dev

# --- Standard ---
NODE_ENV=development